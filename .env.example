# --- Server -------------------------------------------------------------
PORT=3000

# --- MongoDB ------------------------------------------------------------
# Local MongoDB (default). Replace host/credentials for your own setup.
# Examples:
#   Local:            mongodb://127.0.0.1:27017/dronetech
#   Local with auth:  mongodb://user:password@127.0.0.1:27017/dronetech
#   Atlas:            mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dronetech
MONGODB_URI=mongodb://127.0.0.1:27017/dronetech

# --- Optional -----------------------------------------------------------
# Only needed when the frontend is served from a DIFFERENT origin than the
# API (not required for the default setup, which serves both from Express).
# CLIENT_ORIGIN=http://localhost:8080

# Registrations allowed per 15-minute window, per IP address.
RATE_LIMIT_MAX=30
